<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PACKAGE_USAGE_STATS is special access, not a runtime permission:
         the user grants it in Settings > Usage access. It is what lets
         NetworkStatsManager report other apps' totals. Without it, only
         device totals (TrafficStats) work. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 2 foreground service: keeps sampling while the app is in
         the background. The dataSync type is what the service declares;
         it posts one ongoing notification and nothing else. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 3 VPN live mode: BIND_VPN_SERVICE is the permission that
         lets the app's VpnService be bound as the device VPN. It is
         not a data permission: the service counts bytes on-device and
         sends nothing anywhere.
         FOREGROUND_SERVICE_SPECIAL_USE is declared only so the VPN
         service can call startForeground on Android 14+; the service
         still runs if that call fails, because the system VPN
         notification shows while the VPN is active. -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Deliberately NO android.permission.INTERNET: this app must not
         send usage data anywhere. Note on the VPN design: relay
         sockets are created with VpnService.protect() so they bypass
         the tunnel instead of looping into it; they carry other apps'
         traffic to its original destination, they are not the app's
         own network calls, and no usage data is ever transmitted.
         Whether Android permits those protected relay sockets without
         INTERNET is the top Phase 3 device-test item — if relay
         sockets are denied on a real phone, adding INTERNET (with a
         written justification in the plan) is the first fix to try,
         and VPN mode must stay visibly failed until then, never
         silently degraded. -->
    <application
        android:label="mymy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".BackgroundSamplingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".VpnLiveService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_counting" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

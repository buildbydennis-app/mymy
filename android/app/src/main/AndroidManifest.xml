<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PACKAGE_USAGE_STATS is special access, not a runtime permission:
         the user grants it in Settings > Usage access. It is what lets
         NetworkStatsManager report other apps' totals. Without it, only
         device totals (TrafficStats) work. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 2 foreground service: keeps sampling while the app is in
         the background. The dataSync type is what the service declares;
         it posts one ongoing notification and nothing else. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 3 VPN live mode: BIND_VPN_SERVICE is the permission that
         lets the app's VpnService be bound as the device VPN. It is
         not a data permission: the service counts bytes on-device and
         sends nothing anywhere.
         FOREGROUND_SERVICE_SPECIAL_USE is declared only so the VPN
         service can call startForeground on Android 14+; the service
         still runs if that call fails, because the system VPN
         notification shows while the VPN is active. -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Phase 4 LAN-only INTERNET permission — READ BEFORE REMOVING
         OR EXPANDING IT. Phases 1–3 deliberately had NO INTERNET
         permission, and that is still true for everything except
         Phase 4's local-LAN sharing: Android requires INTERNET for
         an app to open sockets at all, including a LAN-only
         HttpServer/HttpClient pair between the user's own devices.
         Scope of this permission as used by MyMy: the Devices tab's
         LAN host (bound to a LAN address only) and guest client,
         talking only to a paired device on the same trusted Wi-Fi,
         token-gated, totals + per-app bytes only. It is NOT used to
         contact any remote server, and no usage data is ever sent
         to the internet. If Phase 4 is ever removed, this permission
         must be removed with it. VPN relay sockets (Phase 3) are a
         separate question: they are protect()ed, and whether they
         need INTERNET on a real phone is still the Phase 3
         device-test item — Phase 4's INTERNET grant does not prove
         or change that test, it only enables LAN sharing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="mymy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".BackgroundSamplingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".VpnLiveService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_counting" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
